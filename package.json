{
  "name": "funpabia",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:export": "mkdir -p backups && wrangler d1 export funpabia --remote --output backups/funpabia-$(date +%F).sql",
    "create-admin": "node tools/create-admin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "knip": "knip",
    "format": "oxfmt",
    "check": "pnpm typecheck && pnpm lint",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "0.10.13",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-router": "1.170.45",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/react-start": "1.169.3",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "kysely": "^0.29.7",
    "kysely-d1": "^0.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@oxlint/plugins": "1.88.0",
    "@tanstack/devtools-vite": "0.8.5",
    "@tanstack/router-cli": "^1.132.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "husky": "^9.1.7",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "1.88.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.151.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "pnpm": ">=10.24.0"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "workerd"
    ]
  }
}
